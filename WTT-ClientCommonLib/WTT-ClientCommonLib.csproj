      <HintPath>..\..\..\EscapeFromTarkov_Data\Managed\UnityEngine.InputLegacyModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>..\..\..\EscapeFromTarkov_Data\Managed\UnityEngine.PhysicsModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>..\..\..\EscapeFromTarkov_Data\Managed\UnityEngine.UI.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.UnityWebRequestAudioModule">
      <HintPath>..\..\..\EscapeFromTarkov_Data\Managed\UnityEngine.UnityWebRequestAudioModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.UnityWebRequestModule">
      <HintPath>..\..\..\EscapeFromTarkov_Data\Managed\UnityEngine.UnityWebRequestModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.UnityWebRequestWWWModule">
      <HintPath>..\..\..\EscapeFromTarkov_Data\Managed\UnityEngine.UnityWebRequestWWWModule.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Patchers\" />
    <Folder Include="Resources\QuestIcons\" />
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="@echo off&#xD;&#xA;setlocal enabledelayedexpansion&#xD;&#xA;&#xD;&#xA;REM Set variables&#xD;&#xA;set MODNAME=$(TargetName)&#xD;&#xA;set DLLPATH=$(TargetDir)$(TargetName).dll&#xD;&#xA;set XMLPATH=$(TargetDir)$(TargetName).xml&#xD;&#xA;set OUTDIR=..\..\..\BepInEx\plugins\%25MODNAME%25&#xD;&#xA;set RESOURCESDIR=$(ProjectDir)Resources&#xD;&#xA;set BUILDOUTDIR=..\Build\BepInEx\plugins\%25MODNAME%25&#xD;&#xA;&#xD;&#xA;REM Patchers source/output&#xD;&#xA;set PATCHERSSRC=$(ProjectDir)Patchers&#xD;&#xA;set PATCHERSOUTDIR=..\..\..\BepInEx\patchers&#xD;&#xA;set BUILDPATCHERSOUTDIR=..\Build\BepInEx\patchers&#xD;&#xA;&#xD;&#xA;REM Create output directories if they don't exist&#xD;&#xA;if not exist &quot;%25OUTDIR%25&quot; mkdir &quot;%25OUTDIR%25&quot;&#xD;&#xA;if not exist &quot;%25BUILDOUTDIR%25&quot; mkdir &quot;%25BUILDOUTDIR%25&quot;&#xD;&#xA;if not exist &quot;%25PATCHERSOUTDIR%25&quot; mkdir &quot;%25PATCHERSOUTDIR%25&quot;&#xD;&#xA;if not exist &quot;%25BUILDPATCHERSOUTDIR%25&quot; mkdir &quot;%25BUILDPATCHERSOUTDIR%25&quot;&#xD;&#xA;&#xD;&#xA;REM Copy the DLL to BepInEx plugins directory&#xD;&#xA;copy /Y &quot;%25DLLPATH%25&quot; &quot;%25OUTDIR%25\&quot; &gt;nul 2&gt;&amp;1&#xD;&#xA;echo [PostBuild] Copied %25MODNAME%25.dll to %25OUTDIR%25&#xD;&#xA;&#xD;&#xA;REM Copy all contents from Resources folder recursively to SPT&#xA;if exist &quot;%25RESOURCESDIR%25&quot; (&#xA;    xcopy &quot;%25RESOURCESDIR%25&quot; &quot;%25OUTDIR%25&quot; /E /I /Y &gt;nul 2&gt;&amp;1&#xA;    echo [PostBuild] Copied Resources to %25OUTDIR%25&#xA;) else (&#xA;    echo [PostBuild] Warning: Resources folder not found at %25RESOURCESDIR%25&#xA;)&#xD;&#xA;&#xD;&#xA;REM Copy the XML file to BepInEx plugins directory&#xD;&#xA;if exist &quot;%25XMLPATH%25&quot; (&#xD;&#xA;    copy /Y &quot;%25XMLPATH%25&quot; &quot;%25OUTDIR%25\&quot; &gt;nul 2&gt;&amp;1&#xD;&#xA;    echo [PostBuild] Copied %25MODNAME%25.xml to %25OUTDIR%25&#xD;&#xA;)&#xD;&#xA;&#xD;&#xA;REM Copy the DLL to Build/BepInEx plugins directory&#xD;&#xA;copy /Y &quot;%25DLLPATH%25&quot; &quot;%25BUILDOUTDIR%25\&quot; &gt;nul 2&gt;&amp;1&#xD;&#xA;echo [PostBuild] Copied %25MODNAME%25.dll to %25BUILDOUTDIR%25&#xD;&#xA;&#xD;&#xA;REM Copy the XML file to Build/BepInEx plugins directory&#xD;&#xA;if exist &quot;%25XMLPATH%25&quot; (&#xD;&#xA;    copy /Y &quot;%25XMLPATH%25&quot; &quot;%25BUILDOUTDIR%25\&quot; &gt;nul 2&gt;&amp;1&#xD;&#xA;    echo [PostBuild] Copied %25MODNAME%25.xml to %25BUILDOUTDIR%25&#xD;&#xA;)&#xD;&#xA;&#xD;&#xA;REM Copy Patchers folder contents to BepInEx patchers directories&#xD;&#xA;if exist &quot;%25PATCHERSSRC%25\&quot; (&#xD;&#xA;    xcopy &quot;%25PATCHERSSRC%25\*&quot; &quot;%25PATCHERSOUTDIR%25\&quot; /E /I /Y &gt;nul&#xD;&#xA;    echo [PostBuild] Copied Patchers to %25PATCHERSOUTDIR%25&#xD;&#xA;&#xD;&#xA;    xcopy &quot;%25PATCHERSSRC%25\*&quot; &quot;%25BUILDPATCHERSOUTDIR%25\&quot; /E /I /Y &gt;nul&#xD;&#xA;    echo [PostBuild] Copied Patchers to %25BUILDPATCHERSOUTDIR%25&#xD;&#xA;) else (&#xD;&#xA;    echo [PostBuild] No Patchers folder found at %25PATCHERSSRC%25&#xD;&#xA;)&#xD;&#xA;&#xD;&#xA;echo [PostBuild] BepInEx build output: %25OUTDIR%25 and %25BUILDOUTDIR%25&#xD;&#xA;&#xD;&#xA;REM Publish to NuGet if Publish configuration&#xD;&#xA;if &quot;$(Configuration)&quot;==&quot;Publish&quot; (&#xD;&#xA;    echo [PostBuild] Publishing $(PackageId) v$(Version) to NuGet...&#xD;&#xA;    call &quot;$(ProjectDir)nuget-publish-project.bat&quot; $(PackageId) $(Version)&#xD;&#xA;)&#xD;&#xA;endlocal" />
  </Target>
</Project>
